{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "precordis/clinic-saas",
    "type": "project",
    "description": "SaaS multi-tenant para clinicas de exames",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "~8.5.0",
        "laravel/framework": "^13.39",
        "laravel/fortify": "^1.0",
        "spatie/laravel-permission": "^8.3",
        "laravel/horizon": "^5.0",
        "laravel/reverb": "^1.0",
        "predis/predis": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "larastan/larastan": "^3.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "check": [
            "@php vendor/bin/pint --test app bootstrap/app.php bootstrap/providers.php config database lang routes tests rector.php",
            "@php vendor/bin/rector process --dry-run",
            "@php vendor/bin/phpstan analyse --memory-limit=512M",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "process-timeout": 900,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
